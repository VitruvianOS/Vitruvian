GRUB_DEFAULT=0
GRUB_TIMEOUT=0
GRUB_DISTRIBUTOR="Vitruvian"
GRUB_CMDLINE_LINUX_DEFAULT="quiet splash loglevel=3 systemd.show_status=0 rd.udev.log_priority=3 fsck.mode=auto fsck.repair=preen"
