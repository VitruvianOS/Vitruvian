# Generates DEBIAN/symbols for the vos package, run by packages.cmake.

if(NOT DEFINED VOS_ABI_VERSION OR NOT DEFINED OUTPUT OR NOT DEFINED LIBS)
	message(FATAL_ERROR
		"gen-vos-symbols: VOS_ABI_VERSION, OUTPUT and LIBS are required")
endif()

# LIBS is a @-joined list of library paths.
string(REPLACE "@" ";" _libs "${LIBS}")

set(_content
	"# Generated by build/gen-vos-symbols.cmake, do not edit.\n")

foreach(_lib IN LISTS _libs)
	if(NOT EXISTS "${_lib}")
		message(FATAL_ERROR "gen-vos-symbols: no such library: ${_lib}")
	endif()

	# Unversioned kits have no SONAME, NEEDED is the plain file name.
	execute_process(COMMAND objdump -p "${_lib}"
		OUTPUT_VARIABLE _dyn RESULT_VARIABLE _rc
		ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
	if(NOT _rc EQUAL 0)
		message(FATAL_ERROR "gen-vos-symbols: objdump -p failed: ${_lib}")
	endif()
	if(_dyn MATCHES "SONAME +([^ \n]+)")
		set(_soname "${CMAKE_MATCH_1}")
	else()
		get_filename_component(_soname "${_lib}" NAME)
	endif()

	# Sorted to keep the package reproducible.
	execute_process(COMMAND nm -D --defined-only --extern-only "${_lib}"
		OUTPUT_VARIABLE _syms RESULT_VARIABLE _rc
		ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
	if(NOT _rc EQUAL 0)
		message(FATAL_ERROR "gen-vos-symbols: nm failed: ${_lib}")
	endif()
	set(_names "")
	string(REPLACE "\n" ";" _lines "${_syms}")
	foreach(_line IN LISTS _lines)
		if(NOT _line MATCHES "^[0-9a-fA-F]+ +[^ ]+ +(.+)$")
			continue()
		endif()
		# dpkg looks unversioned symbols up as name@Base.
		string(REGEX REPLACE "@.*$" "" _name "${CMAKE_MATCH_1}")
		list(APPEND _names "${_name}@Base")
	endforeach()
	if(NOT _names)
		message(FATAL_ERROR "gen-vos-symbols: no exported symbols: ${_lib}")
	endif()
	list(REMOVE_DUPLICATES _names)
	list(SORT _names)

	string(APPEND _content "${_soname} vos #MINVER#\n")
	foreach(_name IN LISTS _names)
		string(APPEND _content " ${_name} ${VOS_ABI_VERSION}\n")
	endforeach()
endforeach()

file(WRITE "${OUTPUT}" "${_content}")
