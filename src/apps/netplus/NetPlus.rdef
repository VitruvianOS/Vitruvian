resource app_signature "application/x-vnd.vos-NetPlus";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major = 0,
	middle = 5,
	minor = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "NetPlus",
	long_info = "NetPlus 0.5 \xc2\xa9 2026 VitruvianOS Project"
};

resource file_types message {
	"types" = "application/x-vnd.Be.URL.http",
	"types" = "application/x-vnd.Be.URL.https",
	"types" = "text/html",
	"types" = "application/xhtml+xml"
};
