#!/bin/sh
#
# Copyright 2026, Dario Casalinuovo. All rights reserved.
# Distributed under the terms of the MIT License.
#
# Write the apt proxy drop-in for V\OS. Run via pkexec from the Network
# preflet; apt runs as root and never sees the user session environment.

set -u

if [ "$(id -u)" -ne 0 ]; then
	echo "vos-set-proxy must run as root (invoke via pkexec)" >&2
	exit 1
fi

if [ $# -lt 1 ]; then
	echo "usage: vos-set-proxy none|manual|automatic [args...]" >&2
	exit 2
fi

mode="$1"
shift

DIR=/etc/apt/apt.conf.d
CONF=$DIR/90-vos-proxy
TMP=$DIR/.90-vos-proxy.tmp.$$

trap 'rm -f "$TMP"' EXIT

# Hostname or IPv4/IPv6 literal. Allowlist rejects quotes, ';', '{}', '$',
# backslash and newlines along with anything else outside the host charset.
_validate_host() {
	_h="$1"
	[ -z "$_h" ] && return 0
	[ "${#_h}" -gt 253 ] && return 1
	case "$_h" in
		*[!A-Za-z0-9._:-]*)
			return 1
			;;
	esac
	return 0
}

# Proxy URL. Forbidden metacharacters first, then a strict allowlist.
_validate_url() {
	_u="$1"
	[ -z "$_u" ] && return 0
	[ "${#_u}" -gt 512 ] && return 1
	case "$_u" in
		-*)
			return 1
			;;
	esac
	# Quotes, backslash, dollar, ';', braces.
	case "$_u" in
		*\"*|*\'*|*\`*|*\\*|*\$*|*\;*|*{*|*}*)
			return 1
			;;
	esac
	# Newlines and CR never belong in a proxy URL.
	_nl='
'
	case "$_u" in
		*"$_nl"*)
			return 1
			;;
	esac
	_cr=$(printf '\r')
	case "$_u" in
		*"$_cr"*)
			return 1
			;;
	esac
	# If anything outside the allowlist remains, reject.
	_keep=$(printf '%s' "$_u" | LC_ALL=C tr -cd 'A-Za-z0-9._~:/?#@!&()*+,=%-')
	[ "${#_u}" -ne "${#_keep}" ] && return 1
	return 0
}

_canon() {
	case "$1" in
		*://*)	printf '%s' "$1" ;;
		*)	printf 'http://%s' "$1" ;;
	esac
}

case "$mode" in
	none)
		rm -f "$CONF"
		exit 0
		;;
	automatic)
		# apt has no PAC support; clear any previous drop-in.
		rm -f "$CONF"
		exit 0
		;;
	manual)
		if [ $# -ne 5 ]; then
			echo "vos-set-proxy: manual needs 5 arguments" >&2
			exit 2
		fi
		http="$1"; https="$2"; ftp="$3"; socks="$4"; ignore="$5"
		for v in "$http" "$https" "$ftp"; do
			# Empty protocol is allowed (user left it blank).
			[ -z "$v" ] && continue
			_validate_url "$v" || {
				echo "vos-set-proxy: rejected value: $v" >&2
				exit 2
			}
		done
		if [ -n "$socks" ]; then
			case "$socks" in
				*://*)	_validate_url "$socks" || {
						echo "vos-set-proxy: rejected SOCKS URL" >&2
						exit 2
					} ;;
				*)	_validate_host "$socks" || {
						echo "vos-set-proxy: rejected SOCKS host" >&2
						exit 2
					} ;;
			esac
		fi
		if [ -n "$ignore" ]; then
			_oldifs="$IFS"
			IFS=','
			# shellcheck disable=SC2086
			set -- $ignore
			IFS="$_oldifs"
			for host in "$@"; do
				host="$(printf '%s' "$host" | tr -d '[:space:]')"
				[ -z "$host" ] && continue
				_validate_host "$host" || {
					echo "vos-set-proxy: rejected ignore host: $host" >&2
					exit 2
				}
			done
		fi
		mkdir -p "$DIR"
		{
			echo "# Generated by V\\OS Network preflet (vos-set-proxy)."
			echo "# Do not edit; re-apply from Network > Proxy."
			if [ -n "$http" ]; then
				echo "Acquire::http::Proxy \"$(_canon "$http")\";"
			fi
			if [ -n "$https" ]; then
				echo "Acquire::https::Proxy \"$(_canon "$https")\";"
			fi
			if [ -n "$ftp" ]; then
				echo "Acquire::ftp::Proxy \"$(_canon "$ftp")\";"
			fi
			if [ -n "$socks" ]; then
				case "$socks" in
					*://*)	echo "Acquire::socks::Proxy \"$socks\";" ;;
					*)	echo "Acquire::socks::Proxy \"socks5://$socks\";" ;;
				esac
			fi
			if [ -n "$ignore" ]; then
				_oldifs="$IFS"
				IFS=','
				# shellcheck disable=SC2086
				set -- $ignore
				IFS="$_oldifs"
				for host in "$@"; do
					host="$(printf '%s' "$host" | tr -d '[:space:]')"
					[ -z "$host" ] && continue
					echo "Acquire::http::Proxy::$host \"DIRECT\";"
					echo "Acquire::https::Proxy::$host \"DIRECT\";"
				done
			fi
		} >"$TMP" || {
			echo "vos-set-proxy: could not write temp drop-in" >&2
			exit 1
		}
		mv -f "$TMP" "$CONF" || {
			echo "vos-set-proxy: could not install drop-in" >&2
			exit 1
		}
		exit 0
		;;
	*)
		echo "vos-set-proxy: unknown mode: $mode" >&2
		exit 2
		;;
esac
