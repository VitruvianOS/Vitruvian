resource app_signature "application/x-vnd.Haiku-MediaPlayer";

resource app_name_catalog_entry "x-vnd.Haiku-MediaPlayer:System name:MediaPlayer";

resource app_version {
	major      = 1,
	middle     = 0,
	minor      = 0,
	variety    = B_APPV_BETA,
	internal   = 0,
	short_info = "MediaPlayer",
	long_info  = "MediaPlayer for V\\OS"
};

resource app_flags B_SINGLE_LAUNCH;

resource file_types message {
	"types" = "application/x-vnd.haiku-playlist",

	"types" = "audio",
	"types" = "video",
	"types" = "audio/mpeg",
	"types" = "audio/mp4",
	"types" = "audio/x-flac",
	"types" = "audio/ogg",
	"types" = "audio/x-vorbis+ogg",
	"types" = "video/mp4",
	"types" = "video/x-matroska",
	"types" = "video/mpeg",
	"types" = "audio/x-midi",
	"types" = "audio/midi"
};

resource vector_icon {
	$"6E63696602011E50C8FF01FFFFFFFF020A0422223E223E3E223E0A03"
	$"2B282B383930020A000100000A01010100"
};
