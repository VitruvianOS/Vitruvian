<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Vitruvian</vendor>
  <vendor_url>https://vitruvian.dev/</vendor_url>

  <action id="org.vitruvian.privilegedguy.run">
    <description>Run the PrivilegedGuy smoke-test helper</description>
    <message>Vitruvian is testing the privileged-action path.</message>
    <!--
      Unconditional auth_admin, on purpose, everywhere. This app exists
      solely to prove that a real auth_admin polkit prompt reaches
      vos-polkit-agent and succeeds end-to-end (see
      janus-session-holder-fix-plan.md and bsudo-vs-polkit-agent.md). Do
      NOT weaken this to "yes" or add a passwordless rule for it -- that
      would defeat the entire point of the app.
    -->
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/privilegedguy-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

</policyconfig>
