resource app_signature "application/x-vnd.vos-Users";

resource app_name_catalog_entry "x-vnd.vos-Users:System name:Users";

resource app_version {
	major     = 1,
	middle    = 0,
	minor     = 0,
	variety   = B_APPV_FINAL,
	internal  = 0,
	short_info = "Users",
	long_info  = "Manage accounts, your picture and password, and administrator rights on V\\OS"
