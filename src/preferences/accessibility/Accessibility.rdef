// Accessibility preferences application resource definition
resource app_version {
	major  = 1,
	middle = 0,
	minor = 0,

	variety = B_APPV_BETA,
	internal = 0,

	short_info = "Accessibility",
	long_info = "Accessibility preferences - Copyright 2026, Dario Casalinuovo"
};

resource app_signature "application/x-vnd.vos-Accessibility";
