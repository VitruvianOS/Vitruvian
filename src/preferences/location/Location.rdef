resource app_signature "application/x-vnd.vos-Location";

resource app_name_catalog_entry "x-vnd.vos-Location:System name:Location";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle  = 0,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "Location Preferences",
	long_info  = "Location Preferences for V\\OS"
};
