// Accessibility replicant resource definition
resource(1, "BEOS:APP_SIG") #'MIMS' "application/x-vnd.vos-AccessibilityReplicant";

resource app_name_catalog_entry "x-vnd.vos-AccessibilityReplicant:System name:AccessibilityReplicant";

resource app_flags B_SINGLE_LAUNCH;

resource app_version {
	major  = 1,
	middle = 0,
	minor = 0,

	variety = B_APPV_BETA,
	internal = 0,

	short_info = "AccessibilityReplicant",
	long_info = "Accessibility Deskbar toggles - Copyright 2026, Dario Casalinuovo"
};
