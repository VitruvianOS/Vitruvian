# Game input for Steam and native games.
#
# uaccess grants the active seat user through logind ACLs, no group.

KERNEL=="uinput", MODE="0660", OPTIONS+="static_node=uinput", \
	TAG+="uaccess"

# Only controller hidraw nodes get the ACL.
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", IMPORT{builtin}="input_id", \
	ENV{ID_INPUT_JOYSTICK}=="1", MODE="0660", TAG+="uaccess"
