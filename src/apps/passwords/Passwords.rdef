resource app_signature "application/x-vnd.Vitruvian-Passwords";

resource app_name_catalog_entry "x-vnd.Vitruvian-Passwords:System name:Passwords";

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,

	variety = B_APPV_ALPHA,
	internal = 0,

	short_info = "Passwords",
	long_info  = "VOS password manager"
};

resource app_flags B_SINGLE_LAUNCH;
